# Salin ke .env (jangan di-commit). Nilai di bawah cocok dengan infra/docker-compose.yml untuk lokal.

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info

# --- Web (Next.js) ---
# Alamat api yang diproksikan Next.js di dev, supaya browser tetap satu domain (localhost:3000/api/v1)
API_INTERNAL_URL=http://127.0.0.1:4000

# Sumber data pasar di web: api (default, butuh api + workers + Redis) atau mock (data contoh)
NEXT_PUBLIC_MARKET_DATA=api
# Opsional: URL WebSocket realtime. Kosong = {domain yang sama}/ws (diteruskan Next di dev, Caddy di produksi)
NEXT_PUBLIC_WS_URL=

# --- Database lokal (docker compose) ---
DATABASE_URL=postgres://ot:ot_local_only@127.0.0.1:5432/ot
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=ot
CLICKHOUSE_PASSWORD=ot_local_only
CLICKHOUSE_DB=ot
REDIS_URL=redis://127.0.0.1:6379

# Akun (langkah 5): origin web yang sah (koma = lebih dari satu; yang pertama dipakai di pesan login wallet)
APP_ORIGIN=http://localhost:3000
APP_NAME="Anthrope Agent"
# CMS admin (langkah 12): wallet yang boleh menulis artikel di /admin, dipisah koma.
# ADMIN_WALLETS=
# Billing Data API (langkah 13). Kosong = belum dikonfigurasi (semua API key paket Free).
# STRIPE_SECRET_KEY=
# Peak AI (langkah 14). Kosong = Peak AI nonaktif; isi dengan key Claude milikmu sendiri (jangan di-commit).
# ANTHROPIC_API_KEY=
# Indexer sendiri (langkah 15). Kosong = Mode A (provider pihak ketiga). Butuh RPC/Geyser berbayar.
# SOLANA_GEYSER_URL=
# SOLANA_GEYSER_TOKEN=

# Swap (langkah 6). Kosong = RPC publik (rate limit ketat; untuk produksi pakai RPC berbayar, mis. Helius/QuickNode).
SWAP_ENABLED=true
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# BASE_RPC_URL=https://mainnet.base.org
# BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
# KYBER_CLIENT_ID=onchain-terminal

# --- Diisi di langkah berikutnya ---
# MARKET_DATA_PROVIDER=        # langkah 1: provider data pihak ketiga
# MARKET_DATA_API_KEY=
# Search (langkah 4): kosong = fallback Postgres pg_trgm (tanpa Docker). Isi untuk Meilisearch
# (docker compose --profile search); api & worker memakainya otomatis.
# MEILI_URL=http://127.0.0.1:7700
# MEILI_MASTER_KEY=
